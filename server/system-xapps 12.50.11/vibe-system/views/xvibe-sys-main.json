{
  "_id": "xvibe-sys-main",
  "_type": "view",
  "_theme": "terminal",
  "_children": [
    {
      "_type": "style-sheet",
      "_href": "",
      "_classes": {}
    },
    {
      "_type": "stack",
      "class": "page-shell",
      "_gap": 0,
      "_children": [
        {
          "_type": "stack",
          "class": "home-container",
          "_gap": 0,
          "_children": [
            {
              "_type": "xvm-view",
              "_view_id": "page-toolbar"
            },
            {
              "_type": "grid",
              "class": "home-content-grid",
              "_children": [
                {
                  "_id": "generated-apps-panel",
                  "_type": "stack",
                  "class": "panel apps-panel",
                  "_gap": 0,
                  "_children": [
                    {
                      "_type": "label",
                      "_text": "My Projects",
                      "class": "panel-title"
                    },
                    {
                      "_type": "label",
                      "_text": "Continue a project or open it in Visual Xpell.",
                      "class": "panel-subtitle"
                    },
                    {
                      "_type": "stack",
                      "class": "actions-row",
                      "_children": [
                        {
                          "_type": "button",
                          "_text": "Refresh",
                          "_variant": "secondary",
                          "_on": {
                            "_click": [
                              {
                                "_module": "xvm",
                                "_op": "list-apps",
                                "_params": {
                                  "_env": "default",
                                  "_include_system": false,
                                  "_output": "system.apps"
                                }
                              }
                            ]
                          }
                        },
                        {
                          "_type": "button",
                          "_text": "+ Create Project",
                          "_on": {
                            "_click": {
                              "_op": "open-object",
                              "_params": {
                                "_id": "generate-app-modal"
                              }
                            }
                          }
                        }
                      ]
                    },
                    {
                      "_type": "label",
                      "_text": "Create a project from a starter to begin, then open it in Visual Xpell.",
                      "class": "empty-projects-helper"
                    },
                    {
                      "_type": "table",
                      "_id": "apps-table",
                      "class": "apps-table",
                      "_data_source": "system.apps",
                      "_row_key": "_app_id",
                      "_on": {
                        "_wormhole-open": {
                          "_module": "xvm",
                          "_op": "list-apps",
                          "_params": {
                            "_env": "default",
                            "_include_system": false,
                            "_output": "system.apps"
                          }
                        }
                      },
                      "_columns": [
                        {
                          "_key": "_app_id",
                          "_title": "App"
                        },
                        {
                          "_key": "_env",
                          "_title": "Env"
                        },
                        {
                          "_key": "actions",
                          "_title": "Actions",
                          "_type": "actions",
                          "_actions": [
                            {
                              "_type": "button",
                              "_text": "Open",
                              "_variant": "primary",
                              "_on": {
                                "_click": {
                                  "_module": "xvm",
                                  "_op": "load-server-app",
                                  "_params": {
                                    "_app_id": "$row._app_id",
                                    "_env": "$row._env",
                                    "_edit": false
                                  }
                                }
                              }
                            },
                            {
                              "_type": "button",
                              "_text": "Edit",
                              "_variant": "primary",
                              "_on": {
                                "_click": {
                                  "_module": "xvm",
                                  "_op": "load-server-app",
                                  "_params": {
                                    "_app_id": "$row._app_id",
                                    "_env": "$row._env",
                                    "_edit": true
                                  }
                                }
                              }
                            },
                            {
                              "_type": "button",
                              "_text": "Set Default",
                              "_variant": "secondary",
                              "_on": {
                                "_click": {
                                  "_module": "xvm",
                                  "_op": "set-default-app",
                                  "_params": {
                                    "_app_id": "$row._app_id",
                                    "_env": "$row._env"
                                  }
                                }
                              }
                            }
                          ]
                        }
                      ],
                      "_empty_text": "No projects yet",
                      "_striped": true,
                      "_hover": true,
                      "_bordered": true
                    }
                  ]
                },
                {
                  "_type": "stack",
                  "class": "home-side-rail",
                  "_gap": 24,
                  "_children": [
                    {
                      "_type": "xvm-view",
                      "_view": "ai-card",
                      "_view_id": "ai-card",
                      "_requires": [
                        "system.ready.wormhole"
                      ],
                      "_on_mount": {
                        "_module": "xai-client",
                        "_op": "get-provider-status",
                        "_params": {
                          "_provider": "aime",
                          "_debug": true
                        },
                        "_output": {
                          "_target": "xdata",
                          "_key": "ai.connection",
                          "_path": "_result"
                        }
                      }
                    },
                    {
                      "_id": "getting-started-panel",
                      "_type": "stack",
                      "class": "panel getting-started-panel",
                      "_gap": 0,
                      "_children": [
                        {
                          "_type": "label",
                          "_text": "Getting Started",
                          "class": "panel-title"
                        },
                        {
                          "_type": "label",
                          "_text": "A short path from starter to running app.",
                          "class": "panel-subtitle getting-started-subtitle"
                        },
                        {
                          "_type": "stack",
                          "class": "getting-started-list",
                          "_children": [
                            {
                              "_type": "label",
                              "_text": "01  Create a project from a starter.",
                              "class": "getting-started-item"
                            },
                            {
                              "_type": "label",
                              "_text": "02  Open it in Visual Xpell.",
                              "class": "getting-started-item"
                            },
                            {
                              "_type": "label",
                              "_text": "03  Set a focus in Guide.",
                              "class": "getting-started-item"
                            },
                            {
                              "_type": "label",
                              "_text": "04  Use Do It to continue.",
                              "class": "getting-started-item"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "_type": "modal",
          "_id": "generate-app-modal",
          "_open": false,
          "_title": "Create Project",
          "_size": "lg",
          "_closable": true,
          "_close_on_backdrop": true,
          "_children": [
            {
              "_id": "create-app-panel",
              "_type": "stack",
              "class": "panel apps-panel",
              "_children": [
                {
                  "_type": "label",
                  "_text": "Create New Project",
                  "class": "panel-title"
                },
                {
                  "_type": "label",
                  "_text": "Choose a starter. You can continue building with Guide and Conversation after creation.",
                  "class": "panel-subtitle"
                },
                {
                  "_type": "label",
                  "_text": "Start small. Guide will help you decide the next step.",
                  "class": "panel-subtitle"
                },
                {
                  "_type": "stack",
                  "class": "form-layout",
                  "_gap": 18,
                  "_children": [
                    {
                      "_type": "field",
                      "_label": "Project ID",
                      "_control": {
                        "_type": "text",
                        "_id": "app-id",
                        "placeholder": "studio-tool, agent-demo, game-test...",
                        "_text": ""
                      },
                      "_data_output": "vibe._app_id",
                      "_update_data_source_event": "input"
                    },
                    {
                      "_type": "grid",
                      "class": "card-grid",
                      "_children": [
                        {
                          "_type": "card",
                          "class": "card",
                          "_hide_image": true,
                          "_title": "Operations",
                          "_text": "Admin-style app with overview, KPI cards, table area and settings shell.",
                          "_actions": [
                            {
                              "_type": "button",
                              "_text": "Create Operations Project",
                              "_variant": "primary",
                              "_on": {
                                "_click": [
                                  {
                                    "_module": "flow-client",
                                    "_op": "trigger",
                                    "_params": {
                                      "_flow_id": "flow-create-app-from-starter",
                                      "_event_payload": {
                                        "_starter_id": "dashboard",
                                        "_app_id": "$xdata:vibe._app_id"
                                      }
                                    }
                                  }
                                ]
                              }
                            }
                          ]
                        },
                        {
                          "_type": "card",
                          "class": "card",
                          "_hide_image": true,
                          "_title": "List / Tracker",
                          "_text": "A clean reusable foundation for lists, trackers, checklists, and lightweight record-management apps.",
                          "_actions": [
                            {
                              "_type": "button",
                              "_text": "Create List / Tracker Project",
                              "_variant": "primary",
                              "_on": {
                                "_click": [
                                  {
                                    "_module": "flow-client",
                                    "_op": "trigger",
                                    "_params": {
                                      "_flow_id": "flow-create-app-from-starter",
                                      "_event_payload": {
                                        "_starter_id": "list",
                                        "_app_id": "$xdata:vibe._app_id"
                                      }
                                    }
                                  }
                                ]
                              }
                            }
                          ]
                        },
                        {
                          "_type": "card",
                          "class": "card",
                          "_hide_image": true,
                          "_title": "🧱 Empty",
                          "_text": "Minimal valid Xpell app with a clean main view, ready for live mutation.",
                          "_actions": [
                            {
                              "_type": "button",
                              "_text": "Create Empty App",
                              "_variant": "primary",
                              "_on": {
                                "_click": [
                                  {
                                    "_module": "flow-client",
                                    "_op": "trigger",
                                    "_params": {
                                      "_flow_id": "flow-create-app-from-starter",
                                      "_event_payload": {
                                        "_starter_id": "empty",
                                        "_app_id": "$xdata:vibe._app_id"
                                      }
                                    }
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "_type": "modal",
          "_id": "api-key-modal",
          "_open": false,
          "_title": "Developer Console API Key",
          "_size": "md",
          "_closable": true,
          "_close_on_backdrop": true,
          "_children": [
            {
              "_type": "field",
              "_label": "API Key",
              "_control": {
                "_type": "text",
                "_data_output": "settings.xpell_api_key"
              }
            }
          ],
          "_actions": [
            {
              "_type": "button",
              "_text": "Save",
              "_on": {
                "_click": [
                  {
                    "_module": "xai-client",
                    "_op": "set-api-key",
                    "_params": {
                      "_provider": "aime",
                      "_xdata_key": "settings.xpell_api_key",
                      "_result_key": "ai.connection",
                      "_error_key": "ai.error"
                    }
                  },
                  {
                    "_module": "xai-client",
                    "_op": "get-provider-status",
                    "_params": {
                      "_provider": "aime",
                      "_result_key": "ai.connection"
                    }
                  },
                  {
                    "_op": "close-object",
                    "_params": {
                      "_id": "api-key-modal"
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
