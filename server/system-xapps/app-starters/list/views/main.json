{
  "_id": "main",
  "_type": "view",
  "_theme": "terminal",
  "_requires": ["system.ready.wormhole"],
  "_children": [
    {
      "_id": "list-starter-style-sheet",
      "_type": "style-sheet",
      "_href": "style/custom.css",
      "_classes": {}
    },
    {
      "_id": "list-starter-shell",
      "_type": "view",
      "class": "list-starter-shell",
      "_children": [
        {
          "_id": "list-starter-header",
          "_type": "toolbar",
          "class": "list-starter-header",
          "_justify": "space-between",
          "_align": "center",
          "_wrap": true,
          "_gap": 16,
          "_children": [
            {
              "_id": "list-starter-title-group",
              "_type": "stack",
              "class": "list-starter-title-group",
              "_direction": "vertical",
              "_gap": 4,
              "_children": [
                {
                  "_id": "list-starter-page-title",
                  "_type": "label",
                  "_text": "<app-title>",
                  "class": "list-starter-page-title"
                },
                {
                  "_id": "list-starter-page-subtitle",
                  "_type": "label",
                  "_text": "<app-description>",
                  "class": "list-starter-page-subtitle"
                }
              ]
            },
            {
              "_id": "list-starter-toolbar-actions",
              "_type": "igroup",
              "class": "list-starter-toolbar-actions",
              "_gap": 10,
              "_align": "center",
              "_wrap": true,
              "_children": [
                {
                  "_id": "list-starter-theme-select",
                  "_type": "xselect",
                  "class": "list-starter-theme-select",
                  "_value": "terminal",
                  "_size": "sm",
                  "_options": [
                    {
                      "value": "terminal",
                      "label": "Terminal"
                    },
                    {
                      "value": "dark",
                      "label": "Dark"
                    },
                    {
                      "value": "light",
                      "label": "Light"
                    }
                  ],
                  "_on_change": {
                    "_module": "xui",
                    "_op": "apply-theme",
                    "_params": {
                      "_theme": "$data"
                    }
                  }
                },
                {
                  "_id": "list-starter-primary-action",
                  "_type": "button",
                  "_text": "Add <primary-entity-title>",
                  "_variant": "primary"
                }
              ]
            }
          ]
        },
        {
          "_id": "list-starter-toolbar",
          "_type": "toolbar",
          "class": "list-starter-toolbar",
          "_justify": "space-between",
          "_align": "center",
          "_wrap": true,
          "_gap": 12,
          "_children": [
            {
              "_id": "list-starter-search",
              "_type": "search",
              "class": "list-starter-search",
              "_placeholder": "Search <primary-entity-title>...",
              "_clearable": true,
              "_icon": true
            },
            {
              "_id": "list-starter-status-filter",
              "_type": "xselect",
              "class": "list-starter-status-filter",
              "_value": "all",
              "_size": "sm",
              "_options": [
                {
                  "value": "all",
                  "label": "All"
                },
                {
                  "value": "active",
                  "label": "Active"
                },
                {
                  "value": "completed",
                  "label": "Completed"
                }
              ]
            }
          ]
        },
        {
          "_id": "list-starter-main-scroll",
          "_type": "scroll",
          "class": "list-starter-main-scroll",
          "_direction": "vertical",
          "_grow": true,
          "_children": [
            {
              "_id": "list-starter-primary-content",
              "_type": "stack",
              "class": "list-starter-primary-content",
              "_direction": "vertical",
              "_gap": 16,
              "_children": [
                {
                  "_id": "list-starter-list-region",
                  "_type": "xsection",
                  "class": "list-starter-section",
                  "_title": "<primary-view-title>",
                  "_subtitle": "Primary <primary-entity-title> records for the confirmed workflow.",
                  "_actions": [
                    {
                      "_id": "list-starter-list-title",
                      "_type": "badge",
                      "_text": "Ready",
                      "_variant": "info",
                      "_pill": true
                    }
                  ],
                  "_children": [
                    {
                      "_id": "list-starter-empty-state",
                      "_type": "empty",
                      "class": "list-starter-empty-state",
                      "_title": "No <primary-entity-title> yet",
                      "_description": "This neutral list region is ready for planned fields, records, filters, and persistence.",
                      "_size": "md",
                      "_align": "center"
                    },
                    {
                      "_id": "list-starter-list-table",
                      "_type": "table",
                      "class": "list-starter-table",
                      "_row_key": "_id",
                      "_columns": [
                        {
                          "_key": "name",
                          "_title": "<primary-entity-title>"
                        },
                        {
                          "_key": "state",
                          "_title": "State"
                        },
                        {
                          "_key": "updated_at",
                          "_title": "Updated"
                        }
                      ],
                      "_rows": [],
                      "_empty_text": "No <primary-entity-title> yet",
                      "_dense": false,
                      "_striped": true,
                      "_hover": true,
                      "_bordered": true
                    }
                  ]
                },
                {
                  "_id": "list-starter-history-region",
                  "_type": "xsection",
                  "class": "list-starter-section",
                  "_title": "History",
                  "_subtitle": "Completed or archived <primary-entity-title> records can appear here when the plan needs them.",
                  "_actions": [
                    {
                      "_id": "list-starter-history-title",
                      "_type": "badge",
                      "_text": "Optional",
                      "_variant": "neutral",
                      "_pill": true
                    }
                  ],
                  "_children": [
                    {
                      "_id": "list-starter-history-table",
                      "_type": "table",
                      "class": "list-starter-table",
                      "_row_key": "_id",
                      "_columns": [
                        {
                          "_key": "name",
                          "_title": "<primary-entity-title>"
                        },
                        {
                          "_key": "state",
                          "_title": "State"
                        },
                        {
                          "_key": "updated_at",
                          "_title": "Updated"
                        }
                      ],
                      "_rows": [],
                      "_empty_text": "No completed records yet",
                      "_dense": true,
                      "_hover": true,
                      "_bordered": true
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "_id": "list-starter-feedback-toast",
      "_type": "toast",
      "_open": false,
      "_text": "List starter ready",
      "_variant": "success",
      "_position": "bottom-right",
      "_closable": true
    }
  ]
}
